import SwiftUI
struct report: View {
    @Environment(\.dismiss) private var dismiss
    @State private var selectedIssue = ""
    @State private var location = ""
    @State private var description = ""
    struct Issue: Identifiable {
        let id = UUID()
        let title: String
        let icon: String
    }
    let issues = [
        Issue(title: "Broken Elevator", icon: "arrow.up.arrow.down.square.fill"),
        Issue(title: "Blocked Pathway", icon: "figure.walk"),
        Issue(title: "Construction", icon: "exclamationmark.triangle.fill"),
        Issue(title: "Ramp Blocked", icon: "figure.roll"),
        Issue(title: "Automatic Door", icon: "door.left.hand.open"),
        Issue(title: "Other", icon: "ellipsis.circle.fill")
    ]
    let columns = [
        GridItem(.flexible()),
        GridItem(.flexible()),
        GridItem(.flexible())
    ]
    var body: some View {
        NavigationStack {
            ZStack {
                Color(red: 0.99, green: 0.97, blue: 0.97)
                    .ignoresSafeArea()
                ScrollView(.vertical, showsIndicators: true) {
                    VStack(alignment: .leading, spacing: 28) {
                        // HEADER
                        HStack {
                            Button {
                                dismiss()
                            } label: {
                                Image(systemName: "arrow.left")
                                    .font(.title2.weight(.bold))
                                    .foregroundColor(.black)
                            }
                            Spacer()
                            Text("Report an Issue")
                                .font(.title2.bold())
                                .foregroundColor(
                                    Color(red: 0.25,
                                          green: 0.16,
                                          blue: 0.16)
                                )
                            Spacer()
                            Color.clear
                                .frame(width: 25)
                        }
                        // WHAT HAPPENED
                        Text("What happened?")
                            .font(.title3.bold())
                        LazyVGrid(columns: columns, spacing: 18) {
                            ForEach(issues) { issue in
                                Button {
                                    selectedIssue = issue.title
                                } label: {
                                    VStack(spacing: 12) {
                                        Image(systemName: issue.icon)
                                            .font(.system(size: 34))
                                            .foregroundColor(
                                                Color(
                                                    red: 0.22,
                                                    green: 0.10,
                                                    blue: 0.58
                                                )
                                            )
                                        Text(issue.title)
                                            .font(.caption.weight(.semibold))
                                            .multilineTextAlignment(.center)
                                            .foregroundColor(.black)
                                    }
                                    .frame(maxWidth: .infinity)
                                    .frame(height: 95)
                                    .background(Color.white)
                                    .cornerRadius(18)
                                    .overlay(
                                        RoundedRectangle(cornerRadius: 18)
                                            .stroke(
                                                selectedIssue == issue.title
                                                ? Color(
                                                    red: 0.22,
                                                    green: 0.10,
                                                    blue: 0.58
                                                )
                                                : .clear,
                                                lineWidth: 3
                                            )
                                    )
                                    .shadow(
                                        color: .black.opacity(0.12),
                                        radius: 6,
                                        x: 0,
                                        y: 4
                                    )
                                }
                            }
                        }
                        // MARK: Location
                        Text("Where is this issue?")
                            .font(.title3.bold())
                        HStack(spacing: 12) {
                            Image(systemName: "mappin.circle.fill")
                                .font(.title2)
                                .foregroundColor(
                                    Color(red: 0.22,
                                          green: 0.10,
                                          blue: 0.58)
                                )
                            TextField("Enter building or location", text: $location)
                                .font(.body)
                        }
                        .padding()
                        .background(Color.white)
                        .cornerRadius(18)
                        .shadow(color: .black.opacity(0.12),
                                radius: 6,
                                x: 0,
                                y: 4)
                        // Description
                        
                        Text("Describe the issue (optional)")
                            .font(.title3.bold())
                        ZStack(alignment: .topLeading) {
                            RoundedRectangle(cornerRadius: 18)
                                .fill(Color.white)
                            TextEditor(text: $description)
                                .padding(8)
                                .background(Color.clear)
                            if description.isEmpty {
                                Text("Type your description here...")
                                    .foregroundColor(.gray)
                                    .padding(.horizontal, 14)
                                    .padding(.vertical, 18)
                                    .allowsHitTesting(false)
                            }
                        }
                        .frame(height: 120)
                        .shadow(color: .black.opacity(0.12),
                                radius: 6,
                                x: 0,
                                y: 4)
                        // MARK: Photo Upload
                        Text("Add a photo (optional)")
                            .font(.title3.bold())
                            .padding(.top, 10)
                        Button {
                            print("Open Photo Picker")
                        } label: {
                            VStack(spacing: 12) {
                                Image(systemName: "camera.fill")
                                    .font(.system(size: 35))
                                    .foregroundColor(
                                        Color(red: 0.22,
                                              green: 0.10,
                                              blue: 0.58)
                                    )
                                Text("Tap to add a photo")
                                    .font(.subheadline)
                                    .foregroundColor(.gray)
                            }
                            .frame(maxWidth: .infinity)
                            .frame(height: 130)
                            .background(Color.white)
                            .cornerRadius(18)
                            .shadow(color: .black.opacity(0.12),
                                    radius: 6,
                                    x: 0,
                                    y: 4)
                        }
                        // MARK: Submit Button
                        Button {
                            print("""
                            Issue: \(selectedIssue)
                            Location: \(location)
                            Description: \(description)
                            """)
                        } label: {
                            NavigationLink(destination: Live_Alerts()) {
                                Text("Submit Report")
                                    .font(.headline.bold())
                                    .foregroundColor(.white)
                                    .frame(maxWidth: .infinity)
                                    .padding()
                            }
                        }
                        .background(
                            Color(red: 0.74,
                                  green: 0.15,
                                  blue: 0.20)
                        )
                        .cornerRadius(18)
                        .shadow(color: .black.opacity(0.2),
                                radius: 6,
                                x: 0,
                                y: 4)
                    } // End VStack
                    .padding(.horizontal, 20)
                    .padding(.top, 20)
                    .padding(.bottom, 40)
                    
                    
                } // End ScrollView
            } // End ZStack
            .navigationBarBackButtonHidden(true)
        } // End NavigationStack
    } // End body
} // End ReportIssueView
#Preview {
    report()
}


