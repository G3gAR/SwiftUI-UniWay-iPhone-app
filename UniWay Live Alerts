                                vertical: true
                            )
                    }

                    Spacer()
                }

                HStack {

                    Text(updateText)
                        .font(.system(size: 13, weight: .bold))
                        .foregroundStyle(mainColor)

                    Spacer()

                    if buttonText.isEmpty == false {

                        Button {
                            print("\(buttonText) pressed")
                        } label: {
                            Text(buttonText)
                                .font(.system(size: 12, weight: .semibold))
                                .foregroundStyle(mainColor)
                                .padding(.horizontal, 16)
                                .frame(height: 28)
                                .background(Color.white)
                                .clipShape(Capsule())
                                .overlay {
                                    Capsule()
                                        .stroke(
                                            mainColor,
                                            lineWidth: 1
                                        )
                                }
                        }
                        .buttonStyle(.plain)
                    }
                }
            }
            .padding(.vertical, 16)
            .padding(.trailing, 12)
        }
