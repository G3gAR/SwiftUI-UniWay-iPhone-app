    func alertCard(
        title: String,
        location: String,
        message: String,
        updateText: String,
        buttonText: String,
        mainColor: Color,
        lightColor: Color,
        icon: Image
    ) -> some View {

        HStack(spacing: 12) {

            ZStack {

                RoundedRectangle(cornerRadius: 3)
                    .fill(mainColor)
                    .frame(width: 4)
            }

            VStack(alignment: .leading, spacing: 10) {

                HStack(alignment: .top, spacing: 14) {

                    ZStack {

                        Capsule()
                            .fill(lightColor)
                            .frame(width: 65, height: 45)
                            .overlay {
                                Capsule()
                                    .stroke(
                                        Color.black.opacity(0.35),
                                        lineWidth: 1
                                    )
                            }
                            .shadow(
                                color: Color.black.opacity(0.18),
                                radius: 3,
                                x: 0,
                                y: 3
                            )

                        icon
                            .resizable()
                            .scaledToFit()
                            .frame(width: 32)
                    }

                    VStack(alignment: .leading, spacing: 4) {

                        Text(title)
                            .font(.system(size: 18, weight: .bold))
                            .foregroundStyle(.black)

                        Text(location)
                            .font(.system(size: 15, weight: .semibold))
                            .foregroundStyle(.black)

                        Text(message)
                            .font(.system(size: 14, weight: .semibold))
                            .foregroundStyle(.black)
                            .fixedSize(
