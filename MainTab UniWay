import SwiftUI

struct MainTabView: View {

    @State var selectedTab = 0
    @State var login: Bool = true
    var body: some View {
        if login {
            TabView(selection: $selectedTab) {
                
                // Map tab
                Uniwaymap2()
                    .tabItem {
                        Image(systemName: "map.fill")
                        Text("Map")
                    }
                    .tag(0)
                
                // Schedule tab
                MySchedule()
                    .tabItem {
                        Image(systemName: "calendar")
                        Text("Schedule")
                    }
                    .tag(1)
                
                // Alerts tab
                Live_Alerts()
                    .tabItem {
                        Image(systemName: "bell.fill")
                        Text("Alerts")
                    }
                    .tag(2)
                
                // Saved tab
                UniWayinputschedule()
                    .tabItem {
                        Image(systemName: "bookmark.fill")
                        Text("Saved")
                    }
                    .tag(3)
                
                // Profile tab
                ProfilePage()
                    .tabItem {
                        Image(systemName: "person.fill")
                        Text("Profile")
                    }
                    .tag(4)
            }
            .tint(
                Color(
                    red: 0.14,
                    green: 0.08,
                    blue: 0.40
                )
            )
        } else {
           UniWayWelcomeback()
        }
    }
}


